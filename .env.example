# Use the latest successful local SQLite snapshot at runtime.
DATA_PROVIDER=database
DATABASE_PATH=.data/pet-travel.sqlite
DATABASE_BACKUP_DIR=.data/backups

# Required only when DATA_PROVIDER=tour-api. Use the Decoding key.
# Keep this server-only; the official gateway currently responds over HTTP.
TOUR_API_KEY=
TOUR_API_BASE_URL=http://apis.data.go.kr/B551011/KorPetTourService2
TOUR_API_PAGE_SIZE=1000
TOUR_API_DETAIL_LIMIT=50
TOUR_API_DETAIL_CONCURRENCY=5
TOUR_API_SYNC_BATCHES=14
TOUR_API_REQUEST_LIMIT=900
TOUR_API_REQUEST_INTERVAL_MS=1200
TOUR_API_RATE_LIMIT_RETRY_MS=5000

# Required for nearby pet supply store search (Kakao Local API).
# Use a Kakao REST API key from https://developers.kakao.com/.
KAKAO_REST_API_KEY=
