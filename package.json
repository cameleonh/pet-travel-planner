{
  "name": "pet-travel-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:sync": "tsx --env-file=.env.local scripts/sync-tour-db.ts",
    "db:sync:daily": "npm run db:backup && tsx --env-file=.env.local scripts/sync-tour-db-daily.ts",
    "db:sync:all": "npm run db:backup && tsx --env-file=.env.local scripts/sync-tour-db-all.ts",
    "db:backup": "tsx --env-file=.env.local scripts/backup-db.ts",
    "sync:accessibility": "tsx --env-file=.env.local scripts/sync-accessibility.ts",
    "sync:camping": "tsx --env-file=.env.local scripts/sync-camping.ts",
    "sync:congestion": "tsx --env-file=.env.local scripts/sync-congestion.ts",
    "sync:trails": "tsx --env-file=.env.local scripts/sync-trails.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "verify": "npm run check && npm run test:coverage && npm run test:e2e && npm run build && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.2.9",
    "better-sqlite3": "12.11.1",
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
